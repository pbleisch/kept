# the built binary, at the repository root. Anchored, or it would also ignore
# cmd/kept — the directory the Makefile builds.
/kept

.DS_Store

# tool session state, not project content
.claude/settings.local.json
.lavish/

# derived from the corpus and the ledger
.kept/index.db
.kept/cache/
.kept/boxes/

# The machine-written tier lives on refs/kept/ledger. Keeping these paths
# ignored prevents an interrupted local migration from putting them back in a
# repair worktree on main.
.kept/ledger/
.kept/artifacts/
