      "text": "  Fact - a claim about a past observation\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "sy8Oh3olLjSh82EmXdQWC",
      "originalText": "  Fact - a claim about a past observation\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NNYG4DyEtBlL-taXX0wJR",
      "type": "text",
      "x": 4225.797312099359,
      "y": 3157.4556323170427,
      "width": 854.5238866827546,
      "height": 270,
      "angle": 0,
      "strokeColor": "#228be6",
      "backgroundColor": "#a5d8ff",
