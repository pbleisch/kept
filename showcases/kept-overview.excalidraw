      "seed": 1723547178,
      "version": 1761,
      "versionNonce": 496258998,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791044849305,
      "link": null,
      "locked": false,
      "text": "  Policy - a rule that must hold in order to land\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "DFKSmqG42aDhacno5EYYR",
      "originalText": "  Policy - a rule that must hold in order to land\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "M7EgKx_x2CmG7fSzATb8I",
      "type": "text",
      "x": 4225.797312099359,
      "y": 2573.7655676207214,
      "width": 867.9317871642111,
      "height": 360,
      "angle": 0,
      "strokeColor": "#40c057",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9Dl",
      "roundness": null,
      "seed": 1681822070,
      "version": 2343,
      "versionNonce": 1629284598,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791044849305,
      "link": null,
      "locked": false,
      "text": "Make rules that block landing changes.\n\nPromises are about the world as it is. Policies\nare about how the world must be after a change.\n\nWhen landing, check every policy relevant to the\nchange. Reject changes that cause policy\nfailures.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Make rules that block landing changes.\n\nPromises are about the world as it is. Policies are about how the world must be after a change.\n\nWhen landing, check every policy relevant to the change. Reject changes that cause policy failures.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5f7CTQF6o2Bx1zjoHrxHz",
      "type": "text",
      "x": 2684.679290262664,
      "y": 2623.9018525046904,
      "width": 333.4573974609375,
      "height": 175.8056305784466,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9S",
      "roundness": null,
      "seed": 798050102,
      "version": 1058,
      "versionNonce": 1925208630,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791044849305,
      "link": null,
      "locked": false,
      "text": "Can Have \nStanding",
      "fontSize": 70.32225223137864,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Can Have \nStanding",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2V8ueSJRLyUOewhDnIQU2",
      "type": "text",
      "x": 2699.842618535512,
      "y": 3188.546091901872,
      "width": 295.836181640625,
      "height": 263.70844586766987,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9T",
      "roundness": null,
      "seed": 2129515178,
      "version": 1159,
      "versionNonce": 2036573046,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791044849305,
      "link": null,
      "locked": false,
      "text": "No \nStanding\nEver",
      "fontSize": 70.32225223137864,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No \nStanding\nEver",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FsOcgU0wJ_WkoChIUP8nn",
      "type": "text",
      "x": 2645.013304898381,
      "y": -8960.923971584903,
      "width": 1761.725230340102,
      "height": 197.2838721016133,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9Y",
      "roundness": null,
      "seed": 1883356598,
      "version": 1469,
      "versionNonce": 162722730,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791049329509,
      "link": null,
      "locked": false,
      "text": "kept is (going to be) my (experimental)\npersonal software factory",
      "fontSize": 78.91354884064532,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "kept is (going to be) my (experimental) personal software factory",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "mge4eD4KMb8PCqUp5VnOz",
      "type": "text",
      "x": 2649.019780808264,
      "y": -8476.250519508654,
      "width": 2014.595592072361,
      "height": 887.7774244572598,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9Y8",
      "roundness": null,
      "seed": 2124553898,
      "version": 1566,
      "versionNonce": 763804470,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791049376499,
      "link": null,
      "locked": false,
      "text": "I define what I want to be true about some piece\nof software\n\nkept delivers the software by observing whether\nthe commitments I've defined are being held, and\ndrives agents to close any gaps\n\nI evolve the software by defining and refining what\nI want",
      "fontSize": 78.91354884064532,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I define what I want to be true about some piece of software\n\nkept delivers the software by observing whether the commitments I've defined are being held, and drives agents to close any gaps\n\nI evolve the software by defining and refining what I want",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "lnCfLWaUUYuGkznhiY04s",
      "type": "text",
      "x": 3122.725644837939,
      "y": -6402.9920740767175,
      "width": 2266.1732280389097,
      "height": 591.8516163048399,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9YG",
      "roundness": null,
      "seed": 428045558,
      "version": 1765,
      "versionNonce": 1331589034,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791049434982,
      "link": null,
      "locked": false,
      "text": "Some goals I've been working toward...\n\n1. Work at a higher level of intention than \"requirements\"\n2. Autonomous end-to-end with enough safety (for me)\n3. Remove unnecessary bookeeping for humans & agents\n4. Don't completely ignore AI-native team environments",
      "fontSize": 78.91354884064532,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Some goals I've been working toward...\n\n1. Work at a higher level of intention than \"requirements\"\n2. Autonomous end-to-end with enough safety (for me)\n3. Remove unnecessary bookeeping for humans & agents\n4. Don't completely ignore AI-native team environments",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ITYrx4P6ow1VWuoBlk6G7",
      "type": "text",
      "x": 3141.8089527153634,
      "y": -3074.4853939572236,
      "width": 2266.1732280389097,
      "height": 98.64193605080665,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
