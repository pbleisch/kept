      "versionNonce": 11437622,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791044849305,
      "link": null,
      "locked": false,
      "text": "Record an observation along with and epistemic\nquality attribute.\n\nFacts have no standing or truthiness but facts\nare such a common artifact type that kept\nprovides a built-in lifecycle for them.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Record an observation along with and epistemic quality attribute.\n\nFacts have no standing or truthiness but facts are such a common artifact type that kept provides a built-in lifecycle for them.",
