      "isDeleted": false,
      "boundElements": null,
      "updated": 1791044849305,
      "link": null,
      "locked": false,
      "text": "  Desire - a no-obligation statement of want",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "CPtV36bszTJy1e6EqAJQn",
      "originalText": "  Desire - a no-obligation statement of want",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "akctCb6A4smLzT339xZAN",
      "type": "text",
      "x": 3164.587433996883,
      "y": 3157.4556323170427,
      "width": 854.5238866827546,
      "height": 405,
      "angle": 0,
      "strokeColor": "#228be6",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9CL",
      "roundness": null,
      "seed": 687117290,
      "version": 2573,
      "versionNonce": 338389494,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791044849305,
      "link": null,
      "locked": false,
      "text": "Provides a safe way to catalog desired future\nwork that kept can teach agents to ignore.\n\nDesires have no standing or truthiness but kept\nimplements a lifecycle.\n\nkept measures the status of a Desire without\nstoring it which provides a simple yet robust\nworkflow.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Provides a safe way to catalog desired future work that kept can teach agents to ignore.\n\nDesires have no standing or truthiness but kept implements a lifecycle.\n\nkept measures the status of a Desire without storing it which provides a simple yet robust workflow.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "QKiPAaMyPEAY17WhSf7pG",
