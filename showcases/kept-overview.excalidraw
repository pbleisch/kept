      "updated": 1791044849305,
      "link": null,
      "locked": false,
      "text": "  Document - the most basic informational artifact",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "QKiPAaMyPEAY17WhSf7pG",
      "originalText": "  Document - the most basic informational artifact",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8qHc4-pQwl3QjqNvDYlyz",
      "type": "text",
      "x": 5287.007190201835,
      "y": 3157.4556323170427,
      "width": 854.5238866827546,
      "height": 315,
      "angle": 0,
      "strokeColor": "#228be6",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9CNV",
      "roundness": null,
      "seed": 2112504438,
      "version": 2728,
      "versionNonce": 729671094,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791044849305,
      "link": null,
      "locked": false,
      "text": "Record content that has no standing or\ntruthiness but can be cited by other artifacts\nand participates in .\n\nFacts have no standing or truthiness so kept\nonly interacts with it through generic artifact\ncommands (list, show, ...)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Record content that has no standing or truthiness but can be cited by other artifacts and participates in .\n\nFacts have no standing or truthiness so kept only interacts with it through generic artifact commands (list, show, ...)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "vjoeufnkyhAgUfrPcM0U2",
