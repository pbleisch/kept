    {
      "id": "Qg5290eGSR9xXPCYT8Cy1",
      "type": "text",
      "x": 7053.780290306359,
      "y": 24448.87248370251,
      "width": 796.9317626953125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA6",
      "roundness": null,
      "seed": 852297654,
      "version": 391,
      "versionNonce": 412964970,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791048878704,
      "link": null,
      "locked": false,
      "text": "The pattern: decisions are for rationale that\ncan be cited and whose revision is visible.\nWhen you",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The pattern: decisions are for rationale that can be cited and whose revision is visible. When you",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "bSeS1RjdPD0OWJ5wAB2fS",
      "type": "text",
      "x": 7053.780290306359,
      "y": 24593.87248370251,
      "width": 763.5955810546875,
      "height": 135,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA7",
      "roundness": null,
      "seed": 1915811498,
      "version": 392,
      "versionNonce": 1290451754,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791048878704,
      "link": null,
      "locked": false,
      "text": "revise a decision, its hash changes, and any\npromise granted against that hash drops\nstanding. That's",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "revise a decision, its hash changes, and any promise granted against that hash drops standing. That's",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "1KksiD4DhuF7VCaczpfLi",
      "type": "text",
      "x": 7053.780290306359,
      "y": 24761.37248370251,
      "width": 794.087646484375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA8",
      "roundness": null,
      "seed": 1048486134,
      "version": 392,
      "versionNonce": 1056818666,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791048878704,
      "link": null,
      "locked": false,
      "text": "the signal — \"the reasoning has changed, the\nold ratification no longer applies.\"",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the signal — \"the reasoning has changed, the old ratification no longer applies.\"",
      "autoResize": false,
      "lineHeight": 1.25
    },
