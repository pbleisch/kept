          "id": "rjzuKnQ0vBCXMxa6pRpoV",
          "type": "text"
        }
      ],
      "updated": 1791044849305,
      "link": null,
      "locked": false
    },
    {
      "id": "rjzuKnQ0vBCXMxa6pRpoV",
      "type": "text",
      "x": 4179.574346557089,
      "y": 2498.628464032696,
      "width": 837.1436767578125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
