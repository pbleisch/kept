      "isDeleted": false,
      "boundElements": null,
      "updated": 1791048224488,
      "link": null,
      "locked": false,
      "text": "artifact standing and truth derive from recorded observations\nand authoritative actions stored in the kept ledger",
      "fontSize": 78.91354884064532,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "artifact standing and truth derive from recorded observations and authoritative actions stored in the kept ledger",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "g_qNDTRF-ZmBO6-MVk8uO",
      "type": "text",
      "x": 3412.903145410221,
      "y": 6069.9518509819345,
      "width": 2162.3966608709466,
      "height": 379.52415154171933,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9Yw",
      "roundness": null,
      "seed": 24436406,
      "version": 4451,
      "versionNonce": 881091818,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791048700390,
      "link": null,
      "locked": false,
      "text": "e.g. kept project's own ledger is 135k commits totaling 560MB\n- < 10MB of core ledger state\n- 40MB of git commit tree overhead\n- 460MB is session diagnostics\n- a misguided promise is causing the diagnostic and overhead bloat  ",
      "fontSize": 60.723864246675085,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "e.g. kept project's own ledger is 135k commits totaling 560MB\n- < 10MB of core ledger state\n- 40MB of git commit tree overhead\n- 460MB is session diagnostics\n- a misguided promise is causing the diagnostic and overhead bloat  ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
