    {
      "id": "JSPZ01a33rnOSiE3HPK_d",
      "type": "text",
      "x": 3367.3833409555127,
      "y": 20894.196109173823,
      "width": 2545.472257860893,
      "height": 1183.7032326096798,
      "angle": 0,
